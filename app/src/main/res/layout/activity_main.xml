<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/browserChrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar:  ←  →  ⟳  ⌂  [ url ]  ⋮  -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/ToolbarButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btnForward"
                style="@style/ToolbarButton"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/btnRefresh"
                style="@style/ToolbarButton"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/btnHome"
                style="@style/ToolbarButton"
                android:contentDescription="@string/home"
                android:src="@drawable/ic_home" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:autofillHints="url"
                android:background="@drawable/url_bar_bg"
                android:hint="@string/url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/on_bg"
                android:textColorHint="@color/on_bg_muted"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/ToolbarButton"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:visibility="gone"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/drivingBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/danger"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/driving_block"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- WebView is added here from code so it can be recreated if its
                 renderer process dies. -->
            <FrameLayout
                android:id="@+id/webContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Home screen -->
            <ScrollView
                android:id="@+id/homeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/home_title"
                        android:textColor="@color/on_bg"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeYoutube"
                        style="@style/HomeButton"
                        android:text="@string/youtube" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeGoogle"
                        style="@style/HomeButton"
                        android:text="@string/google" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeEnter"
                        style="@style/HomeButton"
                        android:text="@string/enter_website" />

                    <TextView
                        android:id="@+id/recentTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:text="@string/recently_visited"
                        android:textColor="@color/on_bg_muted"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:id="@+id/recentList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <!-- Error screen -->
            <LinearLayout
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/on_bg"
                    android:textSize="22sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/errorRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:minWidth="200dp"
                    android:text="@string/refresh"
                    android:textSize="20sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Fullscreen video (WebChromeClient.onShowCustomView) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />
</FrameLayout>
